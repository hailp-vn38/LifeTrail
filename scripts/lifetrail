#!/usr/bin/env bash
# Manage the local LifeTrail Compose applications.
#
# Topology:
#   web       Nginx + built Vue SPA, owns host port 8080, proxies /api/* to server
#   server    Rust/Axum API, internal Compose network only (server:8080)
#   postgres  PostgreSQL/PostGIS, internal only
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly COMPOSE_FILE="$REPOSITORY_DIR/deploy/docker-compose.yml"

usage() {
  cat <<'EOF'
Usage: scripts/lifetrail <command> [app]

Commands:
  start [all|web|server|postgres]    Build if needed and start an app.
  stop [all|web|server|postgres]     Stop an app without removing its data.
  restart [all|web|server|postgres]  Restart an app.
  status                              Show Compose application status.
  logs [all|web|server|postgres]     Follow application logs.
  build [all|web|server]              Build images (default: web and server).
  test                                Check the public web entrypoint and the
                                      API path through Nginx at :8080.

Examples:
  scripts/lifetrail start all
  scripts/lifetrail logs web
  VITE_MAPTILER_KEY=... scripts/lifetrail build web
EOF
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

app_service() {
  case "${1:-all}" in
    all) printf '%s\n' "" ;;
    web|server|postgres) printf '%s\n' "$1" ;;
    *)
      printf 'Unknown app: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

command="${1:-}"
app="${2:-all}"

case "$command" in
  start)
    service="$(app_service "$app")"
    if [[ -n "$service" ]]; then
      compose up -d "$service"
    else
      compose up -d
    fi
    ;;
  stop)
    service="$(app_service "$app")"
    if [[ -n "$service" ]]; then
      compose stop "$service"
    else
      compose stop
    fi
    ;;
  restart)
    service="$(app_service "$app")"
    if [[ -n "$service" ]]; then
      compose restart "$service"
    else
      compose restart
    fi
    ;;
  status)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    compose ps
    ;;
  logs)
    service="$(app_service "$app")"
    if [[ -n "$service" ]]; then
      compose logs --follow "$service"
    else
      compose logs --follow
    fi
    ;;
  build)
    case "$app" in
      all) compose build web server ;;
      web) compose build web ;;
      server) compose build server ;;
      *)
        printf 'Unknown build target: %s\n' "$app" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  test)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    curl --fail --silent --show-error --max-time 10 \
      --output /dev/null --write-out 'LifeTrail web: HTTP %{http_code}\n' \
      http://localhost:8080/
    curl --fail --silent --show-error --max-time 10 \
      --output /dev/null --write-out 'LifeTrail api (through Nginx): HTTP %{http_code}\n' \
      http://localhost:8080/api/v1/devices
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
