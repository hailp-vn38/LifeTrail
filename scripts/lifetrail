#!/usr/bin/env bash
# Manage LifeTrail services and one-shot tools.
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly COMPOSE_FILE="$REPOSITORY_DIR/deploy/docker-compose.yml"
readonly WEB_ENV_FILE="$REPOSITORY_DIR/web/.env.local"

source "$SCRIPT_DIR/lib/lifetrail/compose.sh"
source "$SCRIPT_DIR/lib/lifetrail/targets.sh"
source "$SCRIPT_DIR/lib/lifetrail/usage.sh"

command="${1:-}"
case "$command" in
  start|stop|restart|status|logs)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    select_apps "${2:-all}" || { usage >&2; exit 2; }
    case "$command" in
      start) compose "${COMPOSE_PROFILE_ARGS[@]}" up -d --build "${SERVICES[@]}" ;;
      stop|restart) compose "${COMPOSE_PROFILE_ARGS[@]}" "$command" "${SERVICES[@]}" ;;
      status) compose "${COMPOSE_PROFILE_ARGS[@]}" ps --all "${SERVICES[@]}" ;;
      logs) compose "${COMPOSE_PROFILE_ARGS[@]}" logs --follow "${SERVICES[@]}" ;;
    esac
    ;;
  build)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    case "${2:-all}" in
      all) compose build web server ;;
      web|server) compose build "$2" ;;
      *) printf 'Unknown build target: %s\n' "$2" >&2; usage >&2; exit 2 ;;
    esac
    ;;
  test)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    case "${2:-all}" in
      server-tests)
        compose --profile test run --rm --build server-tests \
          cargo test -- --include-ignored --test-threads=1
        ;;
      all)
        curl --fail --silent --show-error --max-time 10 \
          --output /dev/null --write-out 'LifeTrail web: HTTP %{http_code}\n' \
          http://localhost:8080/
        curl --fail --silent --show-error --max-time 10 \
          --output /dev/null --write-out 'LifeTrail api (through Nginx): HTTP %{http_code}\n' \
          http://localhost:8080/api/v1/devices
        ;;
      *) printf 'Unknown test target: %s\n' "$2" >&2; usage >&2; exit 2 ;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
