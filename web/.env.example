# MapTiler keys are public browser configuration; restrict them to the Web origin.
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=replace-me
VITE_MAPTILER_KEY=

# Dev server: 0.0.0.0 enables access from other devices on the LAN.
LT_DEV_HOST=0.0.0.0
LT_API_PROXY_TARGET=http://127.0.0.1:8081
